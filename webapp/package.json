{
  "name": "cc-map-editor",
  "version": "2.6.0",
  "license": "MIT",
  "repository": "https://github.com/CCDirectLink/crosscode-map-editor",
  "main": "main.js",
  "build": {
    "appId": "CCDirectLink.crosscode.map.editor",
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "files": [
      "main.js",
      "distAngular"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "publish": [
        "github"
      ]
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:aot": "ng serve --aot",
    "startNoLiveReload": "ng serve --live-reload false",
    "build": "ng build",
    "build:prod": "ng build --configuration=production --no-progress",
    "test": "ng test",
    "lint": "ng lint",
    "electron:dev": "electron . --dev --no-sandbox",
    "electron:prod": "electron . --no-sandbox",
    "builder:pack": "electron-builder --dir",
    "builder:dist": "electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run postinstall && npm run build:prod && npm run builder:dist",
    "dist": "npm run build:prod && npm run builder:dist",
    "release": "npm run build:prod && electron-builder --publish always"
  },
  "private": true,
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.5",
    "@angular/cdk": "^22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@babylonjs/core": "^8.30.1",
    "@babylonjs/gui": "^8.30.1",
    "@eslint/js": "^9.39.2",
    "@types/earcut": "^3.0.0",
    "@types/jasmine": "~5.1.9",
    "@types/jsoneditor": "^9.9.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "angular-eslint": "^22.6.0",
    "earcut": "^3.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "idb": "^8.0.4",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "jsoneditor": "^9.10.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "phaser": "3.60.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.3.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0",
    "zone.js": "~0.15.1"
  },
  "dependencies": {
    "@achrinza/node-ipc": "^10.1.11",
    "electron-context-menu": "^4.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "electron-window-state": "^5.0.3"
  }
}
